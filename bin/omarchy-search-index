#!/usr/bin/env bash
set -euo pipefail

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-search"
index="$cache_dir/files"
lock="$cache_dir/.index.lock"
status="$cache_dir/status.json"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/fuzzy-search.json"

mkdir -p "$cache_dir"

force=0
[[ ${1:-} == "--force" ]] && force=1

# Config commands are cheap, but the cached path must never pay for them.
ttl=300
if [[ -s $conf ]]; then
  ttl=$(jq -r '.ttlSeconds // 300' "$conf" 2>/dev/null || echo 300)
fi
[[ -n ${OMARCHY_SEARCH_TTL:-} ]] && ttl=$OMARCHY_SEARCH_TTL

if (( ! force )) && [[ -f $index ]]; then
  now=$(date +%s)
  mtime=$(stat -c %Y "$index" 2>/dev/null || echo 0)
  (( now - mtime < ttl )) && exit 0
fi

exec 9>"$lock"
flock -n 9 || exit 0

tmp="$cache_dir/.files.$$"
started=$(date +%s)
finished=0

# The build may outlive the window that asked for it, so progress lives in a
# file rather than in the caller. A stale pid (SIGKILL) is filtered by the
# reader, so `running: true` with a dead pid still reads as stopped.
write_status() {
  printf '%s\n' "$1" >"$cache_dir/.status.$$"
  mv -f "$cache_dir/.status.$$" "$status"
}

cleanup() {
  rm -f "$tmp"
  if (( !finished )); then
    write_status "$(printf '{"running":false,"pid":%d,"startedAt":%d,"finishedAt":%d,"ok":false}' \
      "$$" "$started" "$(date +%s)")"
  fi
}

trap cleanup EXIT
write_status "$(printf '{"running":true,"pid":%d,"startedAt":%d}' "$$" "$started")"

roots=("$HOME")
excludes=()
hidden=0
one_file_system=1
threads="$(nproc)"
max_results=200000

if [[ -s $conf ]]; then
  mapfile -t configured_roots < <(jq -r '.roots[]?' "$conf" 2>/dev/null || true)
  mapfile -t excludes < <(jq -r '.excludes[]?' "$conf" 2>/dev/null || true)
  [[ $(jq -r '.hidden // false' "$conf" 2>/dev/null) == "true" ]] && hidden=1
  [[ $(jq -r '.oneFileSystem // true' "$conf" 2>/dev/null) == "false" ]] && one_file_system=0
  configured_threads=$(jq -r '.threads // 0' "$conf" 2>/dev/null || echo 0)
  configured_max=$(jq -r '.maxResults // 0' "$conf" 2>/dev/null || echo 0)
  (( configured_threads > 0 )) && threads=$configured_threads
  (( configured_max > 0 )) && max_results=$configured_max

  if (( ${#configured_roots[@]} > 0 )); then
    roots=()
    for root in "${configured_roots[@]}"; do
      root="${root/#\~/$HOME}"
      [[ -d $root ]] && roots+=("$root")
    done
  fi
fi

# Fall back to the pre-settings list for anyone upgrading without a config.
if (( ${#roots[@]} == 0 )) && [[ -f $HOME/.config/omarchy/search-roots ]]; then
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line || $line == \#* ]] && continue
    line="${line/#\~/$HOME}"
    [[ -d $line ]] && roots+=("$line")
  done <"$HOME/.config/omarchy/search-roots"
fi

[[ -n ${OMARCHY_SEARCH_THREADS:-} ]] && threads=$OMARCHY_SEARCH_THREADS
[[ -n ${OMARCHY_SEARCH_MAX_RESULTS:-} ]] && max_results=$OMARCHY_SEARCH_MAX_RESULTS

(( ${#roots[@]} > 0 )) || roots=("$HOME")

args=(--type f --absolute-path --threads "$threads" --max-results "$max_results")
(( hidden )) && args+=(--hidden)
(( one_file_system )) && args+=(--one-file-system)
for exclude in "${excludes[@]}"; do
  [[ -n $exclude ]] && args+=(--exclude "$exclude")
done

fd "${args[@]}" . "${roots[@]}" >"$tmp" 2>/dev/null || true

mv -f "$tmp" "$index"
finished=1
files=$(wc -l <"$index" 2>/dev/null || echo 0)
bytes=$(stat -c %s "$index" 2>/dev/null || echo 0)
write_status "$(printf '{"running":false,"pid":%d,"startedAt":%d,"finishedAt":%d,"files":%d,"bytes":%d,"ok":true}' \
  "$$" "$started" "$(date +%s)" "$files" "$bytes")"
