#!/usr/bin/env bash
set -euo pipefail

verb="${1-}"
path="${2-}"
[[ -n $verb && -n $path ]] || {
  echo "Usage: omarchy-search-state <record|star> <path>" >&2
  exit 2
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
state="$state_dir/search.json"
lock="$state_dir/search.lock"
mkdir -p "$state_dir"
umask 077

exec 9>"$lock"
flock 9

now=$(date +%s)
tmp=$(mktemp "$state_dir/.search.XXXXXX")
trap 'rm -f "$tmp"' EXIT

if [[ -s $state ]]; then
  base=$(cat "$state")
else
  base='{"version":1,"files":{}}'
fi

case "$verb" in
  record)
    jq --arg path "$path" --argjson now "$now" --argjson half "$((30 * 24 * 60 * 60))" '
      .version = 1 |
      .files = (.files // {}) |
      .files[$path] = (.files[$path] // {score: 0, uses: 0, lastUsed: 0, starred: false}) |
      .files[$path].score = ((.files[$path].score // 0) *
        pow(0.5; (($now - (.files[$path].lastUsed // $now)) / $half))) + 1 |
      .files[$path].uses = ((.files[$path].uses // 0) + 1) |
      .files[$path].lastUsed = $now |
      .files[$path].starred = (.files[$path].starred // false)
    ' <<<"$base" >"$tmp"
    ;;
  star)
    jq --arg path "$path" '
      .version = 1 |
      .files = (.files // {}) |
      .files[$path] = (.files[$path] // {score: 0, uses: 0, lastUsed: 0, starred: false}) |
      .files[$path].starred = (.files[$path].starred != true)
    ' <<<"$base" >"$tmp"
    ;;
  *)
    echo "omarchy-search-state: unknown verb '$verb'" >&2
    exit 2
    ;;
esac

mv -f "$tmp" "$state"
trap - EXIT
