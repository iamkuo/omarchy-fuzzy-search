#!/usr/bin/env bash
set -euo pipefail

# Launch the Fuzzy Search settings window as its own app, in its own systemd
# scope so it behaves like any other Omarchy app and is not tied to the shell
# process that asked for it.
here=$(cd "$(dirname "$0")" && pwd)
settings="$here/../settings.py"

if command -v uwsm-app >/dev/null 2>&1; then
  exec uwsm-app -- python3 "$settings" "$@"
fi
exec python3 "$settings" "$@"
